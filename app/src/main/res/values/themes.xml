<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The screen content itself is all Jetpack Compose
         (see presentation/theme/Theme.kt, which handles light/dark switching on
         its own); this XML theme only needs to set the window chrome (status
         bar, background) before Compose takes over. "DayNight" is an AppCompat/
         Material-library concept, not a platform one - android:Theme.Material.
         DayNight.NoActionBar doesn't exist and fails AAPT linking, so this
         inherits a plain platform theme instead (confirmed against the AOSP
         frameworks/base source, not guessed twice). -->
    <style name="Theme.PdfMaster" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/pdf_red_700</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
